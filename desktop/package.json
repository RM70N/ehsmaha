{
  "name": "ehsmaha-desktop",
  "version": "1.1.3",
  "description": "تطبيق سطح المكتب لمنصة احسمها (ehsmaha.com)",
  "author": {
    "name": "احسمها",
    "email": "malshaifan1@gmail.com"
  },
  "homepage": "https://ehsmaha.com",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "sync": "node scripts/sync-site.js",
    "icons": "node scripts/make-icons.js",
    "prepare-assets": "npm run sync && npm run icons",
    "start": "npm run prepare-assets && electron .",
    "start:remote": "npm run prepare-assets && node scripts/start-remote.js",
    "dev": "npm run prepare-assets && electron . --dev",
    "pack": "npm run prepare-assets && electron-builder --dir",
    "dist": "npm run prepare-assets && electron-builder",
    "dist:win": "npm run prepare-assets && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-assets && electron-builder --mac",
    "publish": "echo 'النشر يتم من GitHub Actions فقط (desktop-release.yml)' && exit 1",
    "lint": "node scripts/lint.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run sync && node --test --test-concurrency=1 --test-timeout=150000 test/e2e/app.e2e.test.js",
    "verify:dist": "node scripts/verify-dist.js",
    "verify:version": "node scripts/verify-version.js"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.49.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
