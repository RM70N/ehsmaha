# سيرفر جسر البث — متغيرات البيئة (انسخ القيم في Environment Variables على Render).
# لا تضع أي مفتاح حقيقي في هذا الملف أو في git. نفس الكود يعمل على السيرفرين
# (الأساسي ehsmaha-wbkn والاحتياطي ehsmaha) — الفرق فقط في هذه القيم.

# ===================================================================== أساسي
# المنفذ — Render يضبطه تلقائياً، لا تغيّره هناك.
PORT=8080

# حساب خدمة Firebase (JSON كامل بسطر واحد) لفحص bridgeStreamers/{user}.enabled.
# اختياري: بدونه يُسمح لكل الستريمرز بالاتصال.
FIREBASE_SERVICE_ACCOUNT=

# ===================================================================== مزودو توقيع تيك توك (Euler Stream)
# مفتاح EulerStream الأساسي. اختياري: بدونه يعمل السيرفر على الطبقة المجانية المحدودة لكل IP (وIP Render
# مشترك فيُستنزف بسرعة) ويطبع تحذيراً باللوغ. الاسمان القديمان EULER_SIGN_API_KEY وSIGN_API_KEY مقبولان أيضاً.
EULER_API_KEY=
# مفاتيح إضافية تُستخدم كمزودين متوازيين/احتياطيين (بفواصل)، أو EULER_API_KEY_2 … EULER_API_KEY_9.
# كل مفتاح له حصته وقاطع دائرته: لو تعطّل أحدها يتحول الاتصال فوراً للبقية.
EULER_API_KEYS=
# عنوان سيرفر التوقيع (الافتراضي https://api.eulerstream.com) — لسيرفر توقيع متوافق تستضيفه أنت.
SIGN_API_URL=
# عناوين توقيع بديلة تُستخدم فقط لو تعطّل الأساسي (بفواصل).
TIKTOK_SIGN_FALLBACK_URLS=
# استخدام الطبقة المجانية (بلا مفتاح) كملاذ أخير لو تعطّلت كل المفاتيح. 0 = تعطيل.
TIKTOK_FREE_FALLBACK=1
# بروكسيات لتوزيع الاتصالات على عدة IP (بفواصل): http://user:pass@host:port — كل بروكسي يضاعف المزودين
# بمسار خروج مستقل (طلب التوقيع + جلب رقم الغرفة + الويب سوكيت). اختياري.
TIKTOK_PROXIES=
# جلب رقم الغرفة عبر Euler كمصدر احتياطي أخير (يستهلك حصة إضافية). 0 = تعطيل.
TIKTOK_ROOMID_EULER_FALLBACK=1

# ===================================================================== طابور الاتصال (حماية الحصة)
# أقصى معدل اتصالات جديدة بالدقيقة لكل مزود. المعدل تكيّفي: يهبط تلقائياً عند أي 429 ويرتفع تدريجياً
# مع النجاحات — لكن اضبطه على حد خطتك الفعلي من لوحة Euler. (الافتراضيان 120 و60 تخمين، مو حدود Euler.)
TIKTOK_CONNECT_RATE_PER_MIN=120
# معدل الطبقة المجانية (أقل عادةً).
TIKTOK_FREE_RATE_PER_MIN=60
# أدنى معدل يهبط له AIMD.
TIKTOK_CONNECT_MIN_RATE_PER_MIN=6
# دفعة الاتصالات الفورية المسموحة قبل التقنين.
TIKTOK_CONNECT_BURST=6
# أقصى طلبات اتصال جارية بنفس اللحظة لكل مزود.
TIKTOK_CONNECT_INFLIGHT=4
# قاطع الدائرة: عدد الأعطال المتتالية التي تفتحه، ومدته الأساسية/القصوى (ms). 429 يستخدم retry-after الحقيقي.
TIKTOK_BREAKER_THRESHOLD=3
TIKTOK_BREAKER_COOLDOWN_MS=30000
TIKTOK_BREAKER_MAX_COOLDOWN_MS=300000
# مدة إسكات مفتاح رُفض (402/403) (ms).
TIKTOK_DENIED_COOLDOWN_MS=600000

# ===================================================================== إعادة المحاولة والتعافي
# تراجع أسّي للفشل العابر: يبدأ من BASE ويتضاعف حتى MAX (ms) مع jitter ±25%.
TIKTOK_RETRY_BASE_MS=2000
TIKTOK_RETRY_MAX_MS=60000
# الاستسلام النهائي (رسالة فشل + زر "إعادة المحاولة"): بعد هذا العدد من المحاولات الفاشلة أو هذه المدة (ms).
# بعده تبقى الغرفة تحاول كل PARKED (ms) بالخلفية لو بقي عميل.
TIKTOK_MAX_ATTEMPTS=12
TIKTOK_GIVE_UP_MS=480000
TIKTOK_PARKED_RETRY_MS=300000
# مهلة محاولة اتصال كاملة (ms) ومهلة طلب التوقيع نفسه (ms).
TIKTOK_CONNECT_TIMEOUT_MS=30000
TIKTOK_SIGN_TIMEOUT_MS=15000
# اتصال حي لكن بلا أي بيانات هذي المدة (ms) = ميت بصمت ← يُعاد.
TIKTOK_UPSTREAM_SILENCE_MS=120000

# ===================================================================== الغرف والنبض
# مهلة بقاء الغرفة بعد خروج آخر عميل (ms) حسب كود الإغلاق: 1000 مقصود / 1001 إعادة تحميل الصفحة / غير ذلك انقطاع.
# كل إعادة فتح للغرفة = طلب توقيع جديد، فالمهلة الأطول تحمي الحصة عند الريفرش.
BRIDGE_ROOM_IDLE_GRACE_MS=5000
BRIDGE_ROOM_RELOAD_GRACE_MS=30000
BRIDGE_ROOM_ABNORMAL_GRACE_MS=60000
# فترة نبض ping/pong للعملاء (ms).
BRIDGE_HEARTBEAT_MS=20000
# عدد عيّنات حقول المتابعة المطبوعة باللوغ لكل غرفة (0 = بدون).
BRIDGE_LOG_FOLLOW_SAMPLES=5
