# سيرفر جسر البث — متغيرات البيئة (انسخ القيم في Environment Variables على Render).
# لا تضع أي مفتاح حقيقي في هذا الملف أو في git. نفس الكود يعمل على السيرفرين
# (الأساسي ehsmaha-wbkn والاحتياطي ehsmaha) — الفرق فقط في هذه القيم.

# مفتاح EulerStream (خدمة توقيع اتصال تيك توك التي تستخدمها tiktok-live-connector).
# اختياري: بدونه يعمل السيرفر على الطبقة المجانية المحدودة لكل IP ويطبع تحذيراً باللوغ.
# الاسمان القديمان EULER_SIGN_API_KEY وSIGN_API_KEY مقبولان أيضاً كبديل.
EULER_API_KEY=

# المنفذ — Render يضبطه تلقائياً، لا تغيّره هناك.
PORT=8080

# حساب خدمة Firebase (JSON كامل بسطر واحد) لفحص bridgeStreamers/{user}.enabled.
# اختياري: بدونه يُسمح لكل الستريمرز بالاتصال.
FIREBASE_SERVICE_ACCOUNT=

# اختياري: فترة نبض ping/pong للعملاء بالمللي ثانية (الافتراضي 20000).
# BRIDGE_HEARTBEAT_MS=20000

# اختياري: عدد عيّنات حقول المتابعة المطبوعة باللوغ لكل غرفة (0 = بدون).
# BRIDGE_LOG_FOLLOW_SAMPLES=5
