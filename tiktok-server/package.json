{
  "name": "ehsmaha-tiktok-bridge-server",
  "version": "1.0.0",
  "private": true,
  "description": "Live chat bridge server for ehsmaha.com — hosted once, connects streamers by username only (TikTok, YouTube, Kick), fans out chat/gift/like/follow events to the website over WebSocket.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server.js",
    "postinstall": "playwright install chromium || true",
    "test:kick": "KICK_TRANSPORT=connector node test_kick_contract.js",
    "test": "node --test \"test/*.test.js\"",
    "test:kichat": "node test_kichat_contract.js"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "https-proxy-agent": "^7.0.6",
    "kichat.js": "^1.0.4",
    "kick-live-connector": "^1.0.0",
    "tiktok-live-api-sdk": "0.4.0-beta1",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.18.0",
    "youtube-chat": "^2.2.0"
  }
}
