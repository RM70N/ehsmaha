// قواعد أمان Firestore لكولكشن gameBadges
// ---------------------------------------------------------------------------
// ⚠️ هذا مقتطف (snippet) - مو ملف قواعد كامل. لا تنشره لحاله لأنه راح يلغي
//    قواعد بقية الكولكشنات. انسخ بلوك match/gameBadges فقط وحطه جوّه
//    service cloud.firestore { match /databases/{database}/documents { ... } }
//    بملف firestore.rules الحالي عندك.
//
// ليش هذا مهم لمشكلة "الشارة تنقلب صيانة":
//   لو القواعد المنشورة حالياً تسمح بقيمة وحدة فقط (مثلاً badge == 'maintenance')
//   أو تشترط شرط ما ينطبق، فكل ضغطة على "جديد"/"تحديث جديد"/"ولا شيء" تنرفض
//   بـ permission-denied، وFirestore يلغي الكتابة المحلية ويرجّع آخر قيمة
//   مخزّنة - يعني صيانة. القواعد تحت تسمح بالأربع القيم كلها، وللمالك فقط.
//
// تحقق من القواعد المنشورة فعلياً:
//   Firebase Console → Firestore Database → Rules
// أو:
//   firebase firestore:rules get      (يطبع القواعد الحيّة)
//   firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

match /gameBadges/{gameTag} {
  // أي مستخدم مسجّل دخول لازم يقرأ الشارات - الصفحة الرئيسية تعرضها للكل
  // (publicBadgesBoot). لو منعت القراءة، الشارات ما تظهر لأحد غير المالك.
  allow read: if request.auth != null;

  // الكتابة للمالك فقط، وبقيمة من ضمن الأربع المسموحة لا غير.
  allow write: if request.auth != null
               && request.auth.token.email == 'OWNER_EMAIL_HERE'   // ← بدّله بإيميل حساب المالك
               && request.resource.data.keys().hasOnly(['badge'])
               && request.resource.data.badge in ['new', 'update', 'none', 'maintenance'];
}

// ملاحظة: لو التحقق من المالك عندك يعتمد على مستند بـ users/ بدل إيميل ثابت،
// استبدل شرط الإيميل بـ:
//   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true
// وانتبه إن get() تُحسب كقراءة إضافية على كل عملية كتابة.
