rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // frames/{fileName} — صور الإطارات الديناميكية (رفع عام أو تصميم خاص
    // مُهدى) من تبويب "إطارات" بلوحة المالك (ownerUploadFrameImage). القراءة
    // عامة (الصور تظهر لكل زوار الموقع بصفحات الإطارات/بطاقات المشاركين)،
    // والكتابة محصورة بحساب المالك فقط، بحد أقصى 5 ميجا ونوع صورة فقط.
    match /frames/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'malshaifan1@gmail.com'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
