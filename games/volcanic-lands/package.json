{
  "name": "volcanic-lands",
  "version": "1.0.0",
  "private": true,
  "description": "منطق لعبة «الأراضي البركانية» — TypeScript صارم، يُبنى لملف JS واحد يُحقن في index.html",
  "type": "module",
  "scripts": {
    "test": "vitest run",
