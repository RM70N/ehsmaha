# ===== EHSEMHA Admin Control Center — متغيرات البيئة (بدون أي أسرار) =====
NODE_ENV=production
PORT=8787
TRUST_PROXY=true
# أصل اللوحة (للتحقق من Origin) مثال: https://admin.ehsmaha.com
PUBLIC_ORIGIN=

# --- الحسابان الحصريان (مشتقات Argon2id فقط) — ولّدها بـ: npm run hash-password
OWNER_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# --- الجلسات والحماية (قابلة للتعديل لاحقاً من اللوحة نفسها)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# --- قاعدة اللوحة المستقلة (SQLite) — اربطها بقرص دائم (Persistent Disk)
ADMIN_STORE_PATH=./data/admin.sqlite

# --- Firebase (الموقع) — من الخادم فقط
FIREBASE_PROJECT_ID=streamgame-180b8
FIREBASE_DATABASE_URL=https://streamgame-180b8-default-rtdb.firebaseio.com
# JSON كامل لحساب الخدمة أو base64 له
FIREBASE_SERVICE_ACCOUNT=

# --- Discord (REST بتوكن البوت)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# --- البوت
# مسار مجلد discord-bot (قراءة ملفات الأوامر فقط — لا تعديل)
BOT_DIR=../discord-bot
# قاعدة البوت: PostgreSQL (موصى به) أو مسار ملف SQLite على نفس الجهاز
BOT_DATABASE_URL=
BOT_SQLITE_PATH=
# صحة البوت وAPI الداخلي (المفتاح يبقى في الخادم)
BOT_HEALTH_URL=
BOT_API_BASE_URL=
BOT_API_KEY=
# فحص خدمة ربط البث (اختياري)
BRIDGE_HEALTH_URL=
SITE_URL=https://ehsmaha.com
