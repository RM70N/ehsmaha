{
  "name": "ehsmaha-admin-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "EHSEMHA Admin Control Center — مركز إدارة احسمها المستقل (الموقع + ديسكورد + البوت)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test --test-timeout=60000 --test-concurrency=1 \"test/**/*.test.js\"",
    "check": "node scripts/check.js",
    "test:integration": "firebase emulators:exec --project demo-ehsmaha --only auth,firestore,database \"node --test --test-timeout=120000 --test-concurrency=1 \\\"test/**/*.test.js\\\"\"",
    "gen-docs": "node scripts/gen-docs.js",
    "extract-site-schema": "node scripts/extract-site-schema.js",
    "test:ui": "firebase emulators:exec --project demo-ehsmaha --only auth,firestore,database \"node --test --test-concurrency=1 test/integration/ui.test.js\""
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "firebase-tools": "^13.35.1"
  }
}