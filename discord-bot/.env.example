# ============================================================
#  بوت احسمها + طبقة الـAPI — متغيرات البيئة
#  انسخ هذا الملف إلى .env وعبّي القيم (لا ترفع .env للمستودع أبداً)
#  على Render: كل متغير يُضاف بصفحة Environment للخدمة المعنية
# ============================================================

# ---------- مشترك بين الخدمتين ----------
# مفتاح سري عشوائي (32 حرف فأكثر) — نفس القيمة بالضبط بخدمة البوت وخدمة الـAPI
# توليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# رابط الموقع (للأزرار والروابط)
SITE_URL=https://ehsmaha.com

# مستوى السجلات: error | warn | info | debug
LOG_LEVEL=info
NODE_ENV=production


# ================= خدمة البوت (npm start) =================

# توكن البوت: Discord Developer Portal → Applications → احسمها → Bot → Reset Token
DISCORD_TOKEN=

# Application ID
CLIENT_ID=1552260327008247879

# تسجيل الأوامر تلقائياً عند كل تشغيل للبوت (true/false) — افتراضياً true
AUTO_REGISTER_COMMANDS=true

# (اختياري) سيرفر التطوير — لو معبّى تنسجل الأوامر فيه فقط (تظهر فوراً) بدل التسجيل العالمي
GUILD_ID=

# رابط خدمة الـAPI على Render (بدون / بالنهاية)
API_BASE_URL=https://ehsmaha-discord-api.onrender.com

# معرّفات ديسكورد مخوّلة بالأوامر الإدارية (مفصولة بفاصلة) — بالإضافة لمن عنده Administrator
ADMIN_IDS=

# (اختياري) رابط شعار الفوتر — الافتراضي: SITE_URL/discord-logo.png
LOGO_URL=

# (اختياري) ضبط الأداء
COMMAND_COOLDOWN_MS=3000
BUTTON_COOLDOWN_MS=1000
API_TIMEOUT_MS=5000
LEADERBOARD_CACHE_SECONDS=90

# منفذ خادم البوت (/health + Webhook البث) — Render يعبّيه تلقائياً لما البوت
# Web Service. اتركه فاضي مع Background Worker (/بث يشتغل بالمزامنة الدورية بس).
# PORT=10000

# ---------- قاعدة بيانات البوت (الإدارة، التكتات، التحذيرات، السجل) ----------
# PostgreSQL (مطلوب للإنتاج على Render — قرص Render يُمسح مع كل نشر):
#   Render → New → PostgreSQL → انسخ "Internal Database URL" والصقه هنا
# الجداول تنشأ تلقائياً أول تشغيل. بدون قيمة يستخدم البوت SQLite محلي.
DATABASE_URL=
# (اختياري) SSL: تلقائي (الرابط الداخلي لـRender بدون SSL، الخارجي معه) — true/false لفرضه
# DATABASE_SSL=
# (اختياري، للتطوير المحلي) مسار ملف SQLite
# SQLITE_PATH=./data/bot.sqlite

# ---------- /بث (البث المباشر) ----------
# سر Webhook الجلسات — الموقع/السيرفر يرسله بالهيدر x-webhook-secret
# توليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# بدونه: الـWebhook مقفل (503) و/بث يعتمد على المزامنة الدورية فقط (تأخير حتى 30 ثانية)
STREAM_WEBHOOK_SECRET=
# كل كم ثانية يتزامن مع بيانات الموقع (10-600، افتراضي 30)
STREAM_POLL_SECONDS=30
# أقصى عمر لجلسة بث قبل حذفها تلقائياً (ساعات، افتراضي 6)
STREAM_MAX_HOURS=6
# (اختياري) النطاقات المسموح لها ترسل الـWebhook من المتصفح (CORS) — الافتراضي نطاق الموقع
# WEBHOOK_ALLOWED_ORIGINS=https://ehsmaha.com,https://www.ehsmaha.com

# ---------- التكتات (/دعم) ----------
# عند الإغلاق: archive = نقل لتصنيف "تكتات مغلقة" وقفل الكتابة، delete = حذف الروم
TICKET_CLOSE_MODE=archive
# مهلة الحذف بالثواني (لما TICKET_CLOSE_MODE=delete)
TICKET_DELETE_DELAY_SECONDS=10
# (اختياري) اسم تصنيف الأرشيف — ينشأ تلقائياً لو مو موجود
# TICKET_ARCHIVE_CATEGORY_NAME=تكتات مغلقة
# (اختياري) معرّف التصنيف اللي تنفتح فيه التكتات الجديدة
# TICKET_CATEGORY_ID=

# ---------- التحذيرات (/تحذير) ----------
# أسماء رتب التحذير الثلاث بالترتيب — تنشأ تلقائياً لو ناقصة
# WARNING_ROLE_NAMES=تحذير1,تحذير2,تحذير3

# ---------- Server Members Intent ----------
# لعدّ أعضاء كل رتبة بـ/عرض_الرتب: auto = يستخدمه لو مفعّل بالـDeveloper Portal
# ويشتغل بدونه لو لا، on = إجباري، off = بدونه
MEMBERS_INTENT=auto


# ================= خدمة الـAPI (npm run start:api) =================

# Service Account لمشروع Firebase (streamgame-180b8):
# Firebase Console → Project settings → Service accounts → Generate new private key
# الصق محتوى ملف JSON كاملاً بسطر واحد، أو نسخة base64 منه:
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
# بديل محلي فقط: مسار ملف الـJSON بدل لصق محتواه
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# (اختياري) Realtime Database — الموقع يكتب بعض بيانات اللفلات فيها كنسخة احتياطية
FIREBASE_DATABASE_URL=https://streamgame-180b8-default-rtdb.europe-west1.firebasedatabase.app

# (اختياري)
API_LEADERBOARD_CACHE_SECONDS=120
# بداية الأسبوع للمتصدرين الأسبوعي: 0=الأحد ... 6=السبت، بتوقيت UTC+3 (180 دقيقة)
WEEK_START_DAY=0
TIMEZONE_OFFSET_MINUTES=180
