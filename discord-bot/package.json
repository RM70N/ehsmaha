{
  "name": "ehsmaha-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "بوت ديسكورد \"احسمها\" + طبقة API مرتبطة بقاعدة بيانات ehsmaha.com (Firebase)",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "start:api": "node api/server.js",
    "deploy-commands": "node deploy-commands.js",
    "deploy-commands:guild": "node deploy-commands.js --guild",
    "clear-commands:guild": "node deploy-commands.js --guild --clear",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.0",
    "winston": "^3.19.0"
  }
}
