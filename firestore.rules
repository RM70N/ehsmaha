rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    function currentUsernameLower() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower
        : null;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
                    && (request.auth.uid == uid || request.auth.token.email == 'malshaifan1@gmail.com');
      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if request.auth != null
                    && (request.resource.data.uid == request.auth.uid || isOwner());
      allow update: if false;
      // الحذف مسموح للمالك فقط — يلزم لقسم 12 بلوحة "ادمن احسمها" (تغيير
      // يوزر قسري لمخالفة القواعد).
      allow delete: if isOwner();
    }

    match /gameBadges/{gameTag} {
      allow read: if true;

      allow create: if isOwner()
                    && request.resource.data.badge in ['new', 'update', 'none', 'maintenance']
                    && request.resource.data.keys().hasOnly(['badge']);

      allow update: if isOwner()
                    && request.resource.data.badge in ['new', 'update', 'none', 'maintenance']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badge']);

      allow delete: if isOwner();
    }

    match /activeStreamers/{gameTag} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /playEvents/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteUpdates/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /moderators/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /devSpecial/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /alfawzanSpecial/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /ghnamSpecial/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /moderatorSettings/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /personalMessages/{usernameLower} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == usernameLower;
    }

    match /broadcastMessages/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /liveCommands/{gameTag}/cmds/{cmdId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /liveRounds/{gameTag} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // cwOwnerSessions/{sessionId} — جلسات لعبة "الدول" الحية، مستند لكل ستريمر
    // (معرّف المستند = uid الستريمر) فيه مشاركيه وتوزيع الدول السري وحالة
    // الراوند. يقرأه المالك من تاب "🌍 الدول" بلوحته. سبب وجود المجموعة أصلاً:
    // دعم أكثر من ستريمر يلعب الدول بنفس اللحظة، بدل مستند activeStreamers
    // الواحد لكل لعبة اللي يمسح فيه كل ستريمر بيانات اللي قبله.
    match /cwOwnerSessions/{sessionId} {
      // القراءة للمالك وحده — وهذا هو الضمان الأمني الفعلي هنا: التوزيع سرّي
      // (اسم الدولة مربوط باسم اللاعب)، فلو كانت القراءة عامة مثل
      // activeStreamers لقدر أي لاعب يقرأ المستند ويعرف دولة خصمه ويكسر اللعبة.
      allow read: if isOwner();

      // الكتابة لأي مستخدم مسجّل دخول — نفس activeStreamers/liveRounds بالضبط.
      // كانت مقيّدة بـrequest.auth.uid == sessionId، لكن معرّف المستند يرجع
      // ليوزرنيم البث كبديل لو ما اكتملت دورة المصادقة لحظة ما ضغط الستريمر
      // "ابدأ"، وساعتها الشرط يفشل والكتابة تُرفض بصمت فتختفي الجلسة من لوحة
      // المالك بلا أي أثر. القيد ما كان يحمي بيانات (القراءة ممنوعة أصلاً على
      // الجميع عدا المالك)، فأزيل مقابل موثوقية الظهور.
      allow write: if request.auth != null;
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null && (
        request.auth.uid in pairId.split('_') ||
        (resource.data != null && request.auth.uid in resource.data.uids)
      );
      allow create: if request.auth != null && request.auth.uid in request.resource.data.uids
                    && request.resource.data.uids.size() == 2
                    && pairId == request.resource.data.uids[0] + '_' + request.resource.data.uids[1];
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
      allow update: if false;
    }

    match /friendRequests/{reqId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid
                    && request.resource.data.status == 'pending';
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.hostUid;
      allow update: if request.auth != null;
      // الحذف: المضيف نفسه، أو المالك — يلزم لقسم 1 بلوحة "ادمن احسمها" (زر
      // "إيقاف طارئ") وقسم 7 (إنهاء جلسة عن بُعد).
      allow delete: if request.auth != null && (request.auth.uid == resource.data.hostUid || isOwner());

      match /members/{memberUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && (
          request.auth.uid == memberUid ||
          request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid
        );
        allow update: if request.auth != null && request.auth.uid == memberUid;
        // الحذف: العضو نفسه، أو عضو خامل من أكثر من 60 ثانية، أو المالك — يلزم
        // لقسم 7 بلوحة "ادمن احسمها" (استبعاد مشارك من جلسة نشطة).
        allow delete: if request.auth != null && (
          request.auth.uid == memberUid ||
          isOwner() ||
          (resource.data.lastSeen != null && request.time.toMillis() - resource.data.lastSeen.toMillis() > 60000)
        );
      }

      match /game/{doc} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.authorityUid ||
          request.auth.uid == resource.data.holderUid ||
          (resource.data.participants != null && request.auth.uid in resource.data.participants.keys()) ||
          !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(resource.data.authorityUid))
        );
      }
    }

    match /matchmakingQueue/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      // الحذف: صاحب الصف دائماً، أو أي مستخدم مصادَق لصف "شبح" ما وصلت منه
      // نبضة حياة من أكثر من 60 ثانية.
      //
      // ليش هذا الاستثناء ضروري: أي تبويب ينقفل فجأة (أو ينقطع نهائياً) يترك
      // صفّه بحالة status:'waiting' للأبد، ومحد غير صاحبه كان يقدر يحذفه. النتيجة
      // إن الصف الشبح يتصدّر ترتيب الطابور دائماً، فيُحسب ضمن العدد المعروض
      // ("2 / 10 لاعبين") بينما صاحبه غير موجود أصلاً — فما يبدأ الراوند ولا مرة
      // بتلك اللعبة. وهذا كان أحد الأسباب الجذرية لتعليق "جارِ البحث عن لاعبين...".
      //
      // مهلة 60 ثانية = ثلاث نبضات فائتة (النبضة كل 20 ثانية)، وهامش واسع يتحمّل
      // تذبذب الشبكة وخنق المتصفح للمؤقتات بالخلفية بدون ما يطرد لاعباً حيّاً.
      // نفس نمط ومهلة rooms/{roomId}/members أعلاه بالضبط.
      //
      // نستخدم get('lastSeen', null) بدل الوصول المباشر حتى لو كان الصف مكتوباً
      // جزئياً بلا الحقل — فيُرفض الحذف بهدوء بدل ما يفشل تقييم القاعدة.
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (resource.data.get('lastSeen', null) != null
         && request.time.toMillis() - resource.data.lastSeen.toMillis() > 60000)
      );
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        (resource.data.status == 'waiting' && request.resource.data.status == 'matched'
         && request.resource.data.uid == resource.data.uid)
      );
    }

    match /notifications/{recipientUid}/items/{itemId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == recipientUid;
      allow create: if request.auth != null
                    && request.resource.data.read == false
                    && (
                      (request.resource.data.fromUid == request.auth.uid
                        && request.resource.data.type in ['friendRequest', 'gameInvite'])
                      // adminMessage: رسائل مباشرة/جماعية من لوحة "ادمن احسمها"
                      // (أقسام 2، 3، 7، 9، 10، 12، 13، 14، 19) — من المالك فقط.
                      || (request.resource.data.type in ['immunityGrant', 'adminMessage']
                        && request.auth.token.email == 'malshaifan1@gmail.com')
                    );
    }

    match /eventAccess/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /leaderboards/{streamerUsername} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /levels/{levelKey} {
      allow read: if request.auth != null;

      // الحقول المسموحة بمستند levels.
      // مهم: xp/level/roundsPlayed اختيارية بالفحص (مو مطلوبة بكل كتابة) لأن
      // مسار الإطارات يكتب حقلاً واحداً بـmerge على مستند ممكن ما يكون موجوداً
      // أصلاً (اختيار إطار لشخص ما لعب أي راوند، أو لمفتاح تيك توك اللي كل XP
      // صاحبه محسوب بمفتاح الموقع). إلزامها كان يرفض هذي الكتابات كلها فيروح
      // الاختيار/التفعيل للقاعدة الاحتياطية (RTDB) بدل فايرستور. levelsCommit
      // يكتبها دايماً بأي حال، فالفحص يبقى فعّالاً عليه.
      // levelFrames = الإطارات اللي اختارها اللاعب بنفسه بحصة لفله (أول إطار
      // بلفل 5، وكل +3 لفلات إطار إضافي). منفصل عن ownedFrames اللي يجمع كل ما
      // يملك — عشان منح لوحة المالك يضل مجاني وما يُخصم من حصة اللفل.
      // activeFrameAt = ختم وقت آخر تفعيل بالملّي. لازم يكون مسموحاً هنا، لأن
      // الموقع يحدّد فيه أي قاعدة (فَيرستور أو RTDB) تحمل أحدث تفعيل — وبدونه
      // ترجع مشكلة "الإطار ينحفظ ومع ذلك يرجع القديم بشاشة الانتظار".
      function levelsAllowedKeys() {
        return [
          'key', 'username', 'avatar',
          'xp', 'level', 'roundsPlayed',
          'isRegistered', 'isStreamer', 'isViewer', 'uid',
          'createdAt', 'updatedAt',
          'ownedFrames', 'levelFrames', 'activeFrame', 'activeFrameAt',
          'lastGamePlayed', 'lastGamePlayedAt', 'gamesPlayCount', 'activityLog'
        ];
      }

      function levelsTypesValid() {
        return request.resource.data.get('xp', 0) is number
               && request.resource.data.get('xp', 0) >= 0
               && request.resource.data.get('level', 1) is number
               && request.resource.data.get('level', 1) >= 1
               && request.resource.data.get('roundsPlayed', 0) is number
               && request.resource.data.get('roundsPlayed', 0) >= 0
               && request.resource.data.get('ownedFrames', []) is list
               && request.resource.data.get('levelFrames', []) is list
               && request.resource.data.get('activeFrame', '') is string
               && request.resource.data.get('activeFrameAt', 0) is number
               && request.resource.data.get('lastGamePlayed', '') is string
               && request.resource.data.get('lastGamePlayedAt', request.time) is timestamp
               && request.resource.data.get('gamesPlayCount', {}) is map
               && request.resource.data.get('activityLog', []) is list;
      }

      // نسخة التحديث: تفحص نوع الحقل **فقط لو هذا الحقل نفسه يتغيّر بهذي
      // الكتابة**. بيانات قديمة بنوع غير متوقّع (مثلاً xp محفوظ كنص من نسخة
      // قديمة) ما تعود تقفل المستند بوجه كل كتابة جديدة عليه.
      function levelsChangedTypesValid() {
        let ch = request.resource.data.diff(resource.data).affectedKeys();
        return (!ch.hasAny(['xp']) || (request.resource.data.get('xp', 0) is number && request.resource.data.get('xp', 0) >= 0))
               && (!ch.hasAny(['level']) || (request.resource.data.get('level', 1) is number && request.resource.data.get('level', 1) >= 1))
               && (!ch.hasAny(['roundsPlayed']) || (request.resource.data.get('roundsPlayed', 0) is number && request.resource.data.get('roundsPlayed', 0) >= 0))
               && (!ch.hasAny(['ownedFrames']) || request.resource.data.get('ownedFrames', []) is list)
               && (!ch.hasAny(['levelFrames']) || request.resource.data.get('levelFrames', []) is list)
               && (!ch.hasAny(['activeFrame']) || request.resource.data.get('activeFrame', '') is string)
               && (!ch.hasAny(['activeFrameAt']) || request.resource.data.get('activeFrameAt', 0) is number)
               && (!ch.hasAny(['lastGamePlayed']) || request.resource.data.get('lastGamePlayed', '') is string)
               && (!ch.hasAny(['lastGamePlayedAt']) || request.resource.data.get('lastGamePlayedAt', request.time) is timestamp)
               && (!ch.hasAny(['gamesPlayCount']) || request.resource.data.get('gamesPlayCount', {}) is map)
               && (!ch.hasAny(['activityLog']) || request.resource.data.get('activityLog', []) is list);
      }

      // سقف عدد الإطارات المملوكة — حاجز أمان بحت ضد سكربت يحاول يحشو المستند
      // بآلاف العناصر. لاعب طبيعي بلفل 100 عنده أقل من 35 إطار.
      function framesCountSane() {
        return request.resource.data.get('ownedFrames', []).size() <= 60
               && request.resource.data.get('levelFrames', []).size() <= 60;
      }

      // ملكية الإطارات (ownedFrames) للاعب نفسه:
      // اللاعب صار ياخذ إطاره بنفسه من المعرض لكن باللفل (أول إطار بلفل 5، وكل
      // +3 لفلات إطار إضافي)، فالقاعدة القديمة "ownedFrames ما تتغيّر إلا من
      // المالك" كانت ترفض كل اختيار وتخليه يفشل بصمت. البديل هنا يسمح
      // بالإضافة فقط وبشروط تمنع أي تلاعب فعلي:
      //   1) ممنوع الحذف نهائياً — كل إطار مملوك أصلاً لازم يبقى بالمصفوفة،
      //      فما فيه أحد يقدر يمسح إطاراً ممنوحاً من الإدارة (لا لنفسه ولا لغيره).
      //   2) أي إطار ينضاف لـownedFrames لازم ينضاف معه بـlevelFrames — يعني
      //      ينسجّل صراحة كـ"اختيار لفل"، فما يقدر أحد يضيف إطاراً ويمرّره كأنه
      //      منحة إدارة، وسجل الاختيارات يبقى كامل ومُراجَع.
      //   3) levelFrames نفسها ممنوع الحذف منها — عشان ما يُصفّر عدّاد حصته
      //      ويرجع يختار من جديد بلا حدود.
      // عدد الاختيارات المسموح باللفل يتحقّق بالواجهة (framesRemainingPicks)
      // لأن اللفل الحقيقي ممكن يكون محفوظاً بمستند مفتاح ثاني (مفتاح الموقع)
      // غير المستند اللي تنكتب فيه هذي الكتابة (مفتاح تيك توك)، فالقاعدة ما
      // تقدر تشوفه هنا. المالك معفى من كل هذي الشروط (منح/سحب يدوي).
      function framesNoRemovals() {
        return request.resource.data.get('ownedFrames', []).hasAll(resource.data.get('ownedFrames', []))
               && request.resource.data.get('levelFrames', []).hasAll(resource.data.get('levelFrames', []));
      }

      function framesAdditionsRecordedAsPicks() {
        return request.resource.data.get('ownedFrames', [])
                 .removeAll(resource.data.get('ownedFrames', []))
                 .hasOnly(request.resource.data.get('levelFrames', []));
      }

      function framesSelfPickAllowed() {
        return framesNoRemovals() && framesAdditionsRecordedAsPicks() && framesCountSane();
      }

      // إنشاء مستند جديد: أي ملكية بأول كتابة لازم تكون مسجّلة كاختيار لفل
      // (نفس الشرط 2 فوق) — هذي حالة فعلية: أول إطار يختاره لاعب ما عنده مستند
      // بمفتاح تيك توك بعد، فالكتابة تنشئ المستند بحقلين بس.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(levelsAllowedKeys())
                    && levelsTypesValid()
                    && (isOwner() || (
                         request.resource.data.get('ownedFrames', [])
                           .hasOnly(request.resource.data.get('levelFrames', []))
                         && framesCountSane()
                       ));

      // بالتحديث نفحص **الحقول المتغيّرة فقط** (affectedKeys)، مو كل المستند
      // المدموج. هذا فرق جوهري: كتابة merge تخلي request.resource.data =
      // المستند بعد الدمج، فأي حقل قديم مخزّن من نسخة أقدم للموقع وخارج
      // القائمة كان يرفض **كل** كتابة لاحقة على ذاك المستند للأبد — فيُحفظ
      // الإطار بمفتاح وينرفض بمفتاح ثانٍ (بصمت)، ويرجع الإطار القديم بشاشة
      // الانتظار وبعد أي تحديث للصفحة. الحقول القديمة تبقى كما هي بلا مساس،
      // والحقول اللي فعلاً تتغيّر تبقى محصورة بالقائمة ومفحوصة النوع.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(levelsAllowedKeys())
                    && levelsChangedTypesValid()
                    && (isOwner() || framesSelfPickAllowed());

      // حتى المالك ما يحذف مستنداً يحمل إطارات (ملكية مُختارة/مُمنوحة أو إطار
      // مفعَّل) — حماية من تنظيف المستندات "الفاضية" (levelsCleanupEmptyDocs)
      // اللي كان يبخّر إطاراً لشخص ما لعب أي راوند. لحذف مستند كهذا: صفّر
      // حقول الإطارات أولاً ثم احذفه.
      allow delete: if isOwner()
                    && resource.data.get('ownedFrames', []).size() == 0
                    && resource.data.get('levelFrames', []).size() == 0
                    && resource.data.get('activeFrame', '') == '';
    }

    // framesCatalogExtra/{frameId} — إطارات ديناميكية (لوحة المالك فقط
    // تنشر/تحذف عبر تبويب "إطارات"). القراءة لأي مستخدم مسجّل دخول لازمة
    // فعلياً: بطاقة المشارك بشاشة الانتظار تُبنى على **جهاز الستريمر**، فهو
    // يحتاج يقرأ بيانات إطار خاص يملكه شخص ثانٍ عشان يركّبه حول أفتاره.
    // الوثائق visibility=='private' ما تظهر بأي قائمة/استعلام عام
    // (framesPublicExtraBoot يفلتر visibility=='public' فقط)، فقراءتها عملياً
    // ما تصير إلا لمن عنده الـid أصلاً من ownedFrames/activeFrame.
    match /framesCatalogExtra/{frameId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isOwner();
    }

    match /shopProducts/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /activeImmunities/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /activeRetries/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /activeDoublePoints/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /activeRevivals/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /giftShareLog/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /adminReviveLog/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow create: if request.auth != null
                    && request.resource.data.byAdmin in ['ehsmaha7', 'ic.zx8'];
      allow update, delete: if false;
    }

    match /adminCommandGrants/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                    && request.resource.data.grantedBy in ['ehsmaha7', 'ic.zx8'];
      allow delete: if request.auth != null;
    }

    match /storeNewAnnouncements/current {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /storeSales/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /event100/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /streamers/{uniqueIdLower} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null;
      }

      match /grid/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /participants/{uniqueIdLower} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if false;
      }
    }

    match /event100Rewards/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /strongestStreamer/current {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /streamerBroadcastMessages/current {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /f100WinMultiplier/current {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /f100OnlinePointsMultiplier/current {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /secrets/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /botRoster/{botId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /feedback/{docId} {
      allow read: if isOwner();
      allow create: if request.auth != null;
      // تحديث/حذف مسموح للمالك فقط — يلزم لقسم 9 بلوحة "ادمن احسمها" (تذاكر
      // الدعم: تصنيف، رد، إغلاق/إعادة فتح، أرشفة). كان ممنوعاً تماماً حتى على
      // المالك، فما كان فيه أي طريقة لإدارة التذاكر.
      allow update, delete: if isOwner();
    }

    match /userGames/{gameId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    match /ahsemhaEditors/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /ahsemhaCategories/{catId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'malshaifan1@gmail.com' ||
        (currentUsernameLower() != null && exists(/databases/$(database)/documents/ahsemhaEditors/$(currentUsernameLower())))
      );
    }

    match /ahsemhaSettings/{settingsDocId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'malshaifan1@gmail.com' ||
        (currentUsernameLower() != null && exists(/databases/$(database)/documents/ahsemhaEditors/$(currentUsernameLower())))
      );
    }

    match /referralLinks/{code} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicksCount']) &&
        request.resource.data.clicksCount == resource.data.clicksCount + 1
      ) || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /entrants/{entrantUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == entrantUid;
        allow update, delete: if false;
      }
    }

    match /streamerEvents/{eventId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow update: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      allow delete: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';

      match /sessions/{streamerKeyLower} {
        allow read: if true;
        allow create: if true;
        allow update: if request.auth != null;
        allow delete: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
      }
    }

    match /streamerEventAnnouncements/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /gameOrder/{sectionKey} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'malshaifan1@gmail.com';
    }

    match /bridgeStreamers/{uniqueIdLower} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/homeStats {
      allow read: if true;
      allow create: if isOwner();
      allow update: if request.auth != null && (
        isOwner() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
         request.resource.data.registeredCount == resource.data.registeredCount + 1)
      );
      allow delete: if false;
    }

    // تصحيح: "جسر المصير" (bridge-fate) لا يستخدم Firestore إطلاقاً — بيانات
    // الفعالية الحية تُخزَّن بـRealtime Database (المسارات bridgeEvents/{id}،
    // bridgePlayers/{eventId}/{key}، bridgeBoard/{eventId})، تفادياً لحصة
    // قراءات/كتابات Firestore. كان هنا سابقاً قسم قواعد Firestore بنفس الاسم
    // (بقايا افتراض خاطئ) — أُزيل لأنه ميت فعلياً (index.html ما يكتب/يقرأ
    // Firestore بهذا المسار أبداً). أمان "جسر المصير" الحقيقي يُدار من
    // Firebase Console → Realtime Database → Rules، خارج هذا الملف تماماً —
    // لازم يتأكد المالك إن تلك القواعد تسمح بالقراءة للجميع والكتابة
    // للمستخدمين المسجَّلين دخول فقط (نفس فكرة isOwner لكن بصياغة RTDB:
    // auth.token.email === 'malshaifan1@gmail.com').

    // ==================== لوحة "ادمن احسمها" (لوحة إدارة منفصلة) ====================
    // كل الكولكشنات التالية تخدم admin/ (موقع Netlify منفصل تماماً عن الموقع
    // الرئيسي، نفس مشروع Firebase) — isOwner() هو نفس حساب الأدمن الوحيد.
    // بعضها يحتاج قراءة/كتابة محدودة من مستخدم غير مسجَّل دخول بعد (وقت
    // التسجيل بالموقع الرئيسي) — موضَّح بالتعليق فوق كل استثناء.

    match /adminAuditLog/{id} {
      allow read, write: if isOwner();
    }

    match /adminLoginAttempts/{id} {
      // يُسجَّل عند أي محاولة دخول للوحة (كلمة مرور خاطئة، أو حساب حقيقي
      // غير مصرَّح له) — مقيّد بحقول محدودة حتى لو لم يوجد auth بعد.
      allow create: if request.resource.data.keys().hasOnly(['ts', 'emailAttempted', 'success', 'reason', 'userAgent', 'ip', 'city', 'country'])
                    && request.resource.data.success is bool;
      allow read, update, delete: if isOwner();
    }

    match /adminOwnSessions/{id} {
      allow read, write: if isOwner();
    }

    match /adminSettings/{id} {
      allow read, write: if isOwner();
    }

    match /adminIpBans/{ip} {
      // يُقرأ وقت التسجيل بالموقع الرئيسي (قبل ما يملك المستخدم حساباً بعد).
      allow read: if true;
      allow write: if isOwner();
    }

    match /adminDeviceBans/{deviceId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /adminSecurityAlerts/{id} {
      // كشف محتوى مشبوه بحقل حر (مثل الملاحظات) — يُسجَّل من أي مستخدم مسجَّل.
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }

    match /clientErrorLog/{id} {
      // سجل أخطاء عميل خفيف — يُكتب حتى قبل تسجيل الدخول (صفحة الهبوط مثلاً).
      allow create: if true;
      allow read, update, delete: if isOwner();
    }

    match /deviceSessions/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && (request.auth.uid == uid || isOwner());
    }

    match /siteFlags/{flagId} {
      // تُقرأ من الموقع الرئيسي وقت التسجيل (registration/usernameBlacklist/
      // rateLimiting) وقبل تسجيل الدخول — القراءة عامة، الكتابة للأدمن فقط.
      allow read: if true;
      allow write: if isOwner();
    }

    match /signupRateLimit/{ip} {
      // عداد حماية بسيط من جهة العميل (best-effort، بدون بيانات حساسة) —
      // يُكتب قبل وجود حساب للمستخدم، فلازم يبقى عاماً.
      allow read, write: if true;
    }

    match /gameContentBanks/{bankId} {
      // إضافات/استثناءات فوق بنوك محتوى مدمجة بالكود (أسئلة الطريق الزجاجي،
      // مواضيع توب 10...) — تُقرأ من كل اللاعبين أثناء اللعب، تُكتب من الأدمن فقط.
      allow read: if true;
      allow write: if isOwner();
    }

    // framesCatalog — كولكشن ميّت: كانت لوحة الإدارة ترفع الإطارات عليه لكن
    // الموقع الرئيسي ما يقرأه بأي مكان، فالإطار المرفوع ما يظهر بالمعرض أبداً.
    // القسم 4 صار يكتب على framesCatalogExtra (المعرّف بقواعده فوق) — وهو
    // المصدر الحقيقي اللي يقرأه framesPublicExtraBoot بالموقع. القاعدة تُترك
    // بصلاحية قراءة فقط عشان أي بيانات قديمة تظل قابلة للاطلاع/النقل يدوياً،
    // بلا كتابة جديدة عليها.
    match /framesCatalog/{frameId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /badgeDefs/{badgeId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /streamerProfiles/{usernameLower} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /streamerApplications/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }

    match /deletedUsersBackup/{uid} {
      allow read, write: if isOwner();
    }

    match /adminNotes/{uid} {
      allow read, write: if isOwner();
    }

    match /feedbackCannedResponses/{id} {
      allow read, write: if isOwner();
    }

    match /contentReports/{id} {
      // بلاغ من أي مستخدم مسجَّل (زر إبلاغ مستقبلي) — القراءة/المراجعة للأدمن فقط.
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }

    match /aiGameSubmissions/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isOwner();
    }

    match /aiGameTemplates/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /siteContent/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /scheduledContent/{id} {
      allow read, write: if isOwner();
    }

    match /siteContentArchive/{id} {
      allow read, write: if isOwner();
    }

    match /uiText/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /uiTextArchive/{id} {
      allow read, write: if isOwner();
    }

    match /abExperiments/{id} {
      allow read, write: if isOwner();
    }

    match /adminRoles/{id} {
      allow read, write: if isOwner();
    }

    match /backupsLog/{id} {
      allow read, write: if isOwner();
    }

    match /financialTransactions/{id} {
      allow read, write: if isOwner();
    }

    match /subscriptionPlans/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /overlayArchive/{id} {
      allow read, write: if isOwner();
    }

    match /specialEvents/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /specialEventsArchive/{id} {
      allow read, write: if isOwner();
    }

    match /apiHealthLog/{id} {
      allow read, write: if isOwner();
    }

    match /contests/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /recurringContestTemplates/{id} {
      allow read, write: if isOwner();
    }

    match /broadcastCampaigns/{id} {
      allow read, write: if isOwner();
    }

    match /scheduledNotifications/{id} {
      allow read, write: if isOwner();
    }

    match /notifTemplates/{id} {
      allow read, write: if isOwner();
    }

    match /xpSeasonsArchive/{seasonId}/players/{uid} {
      allow read, write: if isOwner();
    }

    match /gameConfig/{gameTag} {
      // إعدادات قابلة للتعديل لكل لعبة (نقاط، توقيت، صعوبة...) تقرأها اللعبة
      // نفسها وقت التشغيل.
      allow read: if true;
      allow write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
