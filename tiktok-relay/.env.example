# منفذ الخدمة
PORT=10000

# المزوّد الأساسي: piratetok (بلا مفتاح). الاحتياطي يُفعَّل بمتغير منفصل أدناه
PROVIDER=piratetok

# تفعيل المزوّد الاحتياطي (tiktok-live-connector عبر حد Euler المجاني بلا مفتاح) عند فتح قاطع الأساسي
ENABLE_FALLBACK=1

# بيانات اعتماد Firebase Admin (JSON كامل لحساب خدمة) — لازمة للتحقق من حسابات احسمها ولقراءة/كتابة ربط الحسابات
FIREBASE_SERVICE_ACCOUNT=

# حد الفحص الدوري ومعدل الاتصال العام (قيم افتراضية معقولة، عدّلها عند الحاجة)
POLL_INTERVAL_MIN_MS=30000
POLL_INTERVAL_MAX_MS=60000
POLL_MAX_CONCURRENCY=5
GLOBAL_RATE_PER_SEC=2
GLOBAL_RATE_BURST=5

# قاطع الدائرة
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MS=30000
BREAKER_MAX_COOLDOWN_MS=300000
BREAKER_BLOCKED_COOLDOWN_MS=600000
